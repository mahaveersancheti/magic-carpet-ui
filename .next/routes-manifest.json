      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/home",
      "regex": "^/home(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/home(?:/)?$"
    },
    {
      "page": "/linkedin-action",
      "regex": "^/linkedin\\-action(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/linkedin\\-action(?:/)?$"
    },
    {
      "page": "/otp",
      "regex": "^/otp(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/otp(?:/)?$"
    },
    {
      "page": "/products",
      "regex": "^/products(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/products(?:/)?$"
    },
    {
      "page": "/request",
      "regex": "^/request(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/request(?:/)?$"
    },
    {
      "page": "/signin",
      "regex": "^/signin(?:/)?$",
